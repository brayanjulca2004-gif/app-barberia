<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Fondo del campo -->
    <solid android:color="#08263A" />

    <!-- Borde azul -->
    <stroke
        android:width="1.5dp"
        android:color="#1599E8" />

    <!-- Esquinas redondeadas -->
    <corners android:radius="8dp" />

    <!-- Espacio interno -->
    <padding
        android:left="12dp"
        android:top="2dp"
        android:right="12dp"
        android:bottom="2dp" />

</shape>