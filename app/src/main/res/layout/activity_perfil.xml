<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9FC">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="74dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:paddingStart="16dp"
        android:paddingEnd="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvVolverPerfil"
            android:layout_width="42dp"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:text="‹"
            android:textSize="36sp"
            android:textColor="#2563A6"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Volver"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="46dp"
            android:layout_height="46dp"
            app:cardBackgroundColor="#EAF2FB"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            android:clipToOutline="true">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/logo_barberapp"
                android:scaleType="centerCrop"
                android:contentDescription="Logo BarberApp"/>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="BARBERAPP"
            android:textColor="#1D3557"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"/>
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollPerfil"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#F7F9FC"
        android:fillViewport="false"
        android:clipToPadding="false"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/bottomNavContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="27dp"
            android:paddingBottom="32dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#1D3557"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="23dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="MI CUENTA"
                        android:textSize="11sp"
                        android:textColor="#C9DBEF"
                        android:textStyle="bold"
                        android:letterSpacing="0.10"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Mi perfil"
                        android:textSize="25sp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:layout_marginTop="14dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Consulta y actualiza tu información personal."
                        android:textSize="13sp"
                        android:textColor="#D8E5F3"
                        android:layout_marginTop="10dp"
                        android:lineSpacingExtra="4dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvEstadoPerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textColor="#607B9B"
                android:textSize="13sp"
                android:padding="7dp"
                android:visibility="gone"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                android:layout_marginTop="18dp"
                app:strokeColor="#E0E9F4"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="23dp"
                    android:gravity="center_horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="112dp"
                        android:layout_height="112dp"
                        app:cardBackgroundColor="#EAF2FB"
                        app:cardCornerRadius="56dp"
                        app:cardElevation="0dp"
                        android:clipToOutline="true"
                        app:strokeColor="#DDE9F6"
                        app:strokeWidth="2dp">

                        <ImageView
                            android:id="@+id/imgFotoPerfil"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/logo_barberapp"
                            android:scaleType="centerCrop"
                            android:contentDescription="Fotografía de perfil"/>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Foto de perfil"
                        android:textSize="16sp"
                        android:textColor="#1D3557"
                        android:textStyle="bold"
                        android:layout_marginTop="13dp"
                        android:gravity="center"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCambiarFoto"
                        android:layout_width="wrap_content"
                        android:layout_height="56dp"
                        android:layout_marginTop="12dp"
                        android:text="Cambiar foto"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#2563A6"
                        android:textAllCaps="false"
                        app:backgroundTint="#EAF2FB"
                        app:cornerRadius="15dp"/>

                    <TextView
                        android:id="@+id/tvEstadoFoto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:textColor="#607B9B"
                        android:textSize="13sp"
                        android:padding="7dp"
                        android:visibility="gone"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                android:layout_marginTop="20dp"
                app:strokeColor="#E0E9F4"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="21dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Datos personales"
                        android:textSize="20sp"
                        android:textColor="#1D3557"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Actualiza tus datos de contacto."
                        android:textSize="13sp"
                        android:textColor="#607B9B"
                        android:layout_marginTop="6dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="NOMBRE COMPLETO"
                        android:textSize="11sp"
                        android:textColor="#2563A6"
                        android:textStyle="bold"
                        android:layout_marginTop="27dp"
                        android:letterSpacing="0.05"
                        android:labelFor="@id/etNombrePerfil"/>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="#F7F9FC"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        android:layout_marginTop="10dp"
                        app:strokeColor="#DFE8F3"
                        app:strokeWidth="1dp">

                        <EditText
                            android:id="@+id/etNombrePerfil"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:background="@android:color/transparent"
                            android:hint="Nombre completo"
                            android:inputType="textPersonName|textCapWords"
                            android:singleLine="true"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:textColor="#1D3557"
                            android:textColorHint="#91A3B8"
                            android:textSize="14sp"/>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="CORREO ELECTRÓNICO"
                        android:textSize="11sp"
                        android:textColor="#2563A6"
                        android:textStyle="bold"
                        android:layout_marginTop="22dp"
                        android:letterSpacing="0.05"
                        android:labelFor="@id/etCorreoPerfil"/>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="#F7F9FC"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        android:layout_marginTop="10dp"
                        app:strokeColor="#DFE8F3"
                        app:strokeWidth="1dp">

                        <EditText
                            android:id="@+id/etCorreoPerfil"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:background="@android:color/transparent"
                            android:hint="Correo electrónico"
                            android:inputType="textEmailAddress"
                            android:singleLine="true"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:textColor="#1D3557"
                            android:textColorHint="#91A3B8"
                            android:textSize="14sp"/>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="TELÉFONO"
                        android:textSize="11sp"
                        android:textColor="#2563A6"
                        android:textStyle="bold"
                        android:layout_marginTop="22dp"
                        android:letterSpacing="0.05"
                        android:labelFor="@id/etTelefonoPerfil"/>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="#F7F9FC"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        android:layout_marginTop="10dp"
                        app:strokeColor="#DFE8F3"
                        app:strokeWidth="1dp">

                        <EditText
                            android:id="@+id/etTelefonoPerfil"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:background="@android:color/transparent"
                            android:hint="Número de teléfono"
                            android:inputType="phone"
                            android:singleLine="true"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:textColor="#1D3557"
                            android:textColorHint="#91A3B8"
                            android:textSize="14sp"
                            android:maxLength="9"/>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGuardarPerfil"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="28dp"
                        android:text="Guardar cambios"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:textAllCaps="false"
                        app:backgroundTint="#1D3557"
                        app:cornerRadius="15dp"/>

                    <TextView
                        android:id="@+id/tvEstadoDatos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:textColor="#607B9B"
                        android:textSize="13sp"
                        android:padding="7dp"
                        android:visibility="gone"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                android:layout_marginTop="20dp"
                app:strokeColor="#E0E9F4"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="21dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Seguridad de tu cuenta"
                        android:textSize="20sp"
                        android:textColor="#1D3557"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Cambia tu contraseña cuando lo necesites."
                        android:textSize="13sp"
                        android:textColor="#607B9B"
                        android:layout_marginTop="6dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="CONTRASEÑA ACTUAL"
                        android:textSize="11sp"
                        android:textColor="#2563A6"
                        android:textStyle="bold"
                        android:layout_marginTop="27dp"
                        android:letterSpacing="0.05"
                        android:labelFor="@id/etPasswordActual"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        app:boxBackgroundMode="outline"
                        app:boxBackgroundColor="#F7F9FC"
                        app:boxStrokeColor="#DFE8F3"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:endIconMode="password_toggle"
                        app:endIconTint="#2563A6"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPasswordActual"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:background="@android:color/transparent"
                            android:hint="Contraseña actual"
                            android:inputType="textPassword"
                            android:singleLine="true"
                            android:paddingStart="16dp"
                            android:textColor="#1D3557"
                            android:textColorHint="#91A3B8"
                            android:textSize="14sp"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="NUEVA CONTRASEÑA"
                        android:textSize="11sp"
                        android:textColor="#2563A6"
                        android:textStyle="bold"
                        android:layout_marginTop="22dp"
                        android:letterSpacing="0.05"
                        android:labelFor="@id/etPasswordNueva"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        app:boxBackgroundMode="outline"
                        app:boxBackgroundColor="#F7F9FC"
                        app:boxStrokeColor="#DFE8F3"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:endIconMode="password_toggle"
                        app:endIconTint="#2563A6"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPasswordNueva"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:background="@android:color/transparent"
                            android:hint="Nueva contraseña"
                            android:inputType="textPassword"
                            android:singleLine="true"
                            android:paddingStart="16dp"
                            android:textColor="#1D3557"
                            android:textColorHint="#91A3B8"
                            android:textSize="14sp"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="CONFIRMAR CONTRASEÑA"
                        android:textSize="11sp"
                        android:textColor="#2563A6"
                        android:textStyle="bold"
                        android:layout_marginTop="22dp"
                        android:letterSpacing="0.05"
                        android:labelFor="@id/etPasswordConfirmar"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        app:boxBackgroundMode="outline"
                        app:boxBackgroundColor="#F7F9FC"
                        app:boxStrokeColor="#DFE8F3"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:endIconMode="password_toggle"
                        app:endIconTint="#2563A6"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPasswordConfirmar"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:background="@android:color/transparent"
                            android:hint="Repite tu nueva contraseña"
                            android:inputType="textPassword"
                            android:singleLine="true"
                            android:paddingStart="16dp"
                            android:textColor="#1D3557"
                            android:textColorHint="#91A3B8"
                            android:textSize="14sp"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCambiarPassword"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="28dp"
                        android:text="Actualizar contraseña"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:textAllCaps="false"
                        app:backgroundTint="#1D3557"
                        app:cornerRadius="15dp"/>

                    <TextView
                        android:id="@+id/tvEstadoPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:textColor="#607B9B"
                        android:textSize="13sp"
                        android:padding="7dp"
                        android:visibility="gone"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <pe.edu.cibertec.app_barberia.perfil.BotonCerrarSesion
                android:id="@+id/btnCerrarSesionPerfil"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="20dp"
                android:text="Cerrar sesión"
                android:textAllCaps="false"
                android:textColor="#B42336"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="#FFF1F2"
                app:strokeColor="#F4C5CA"
                app:strokeWidth="1dp"
                app:cornerRadius="15dp"/>
        </LinearLayout>
    </ScrollView>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/bottomNavContainer"
        android:name="pe.edu.cibertec.app_barberia.navegacion.BottomNavFragment"
        android:layout_width="0dp"
        android:layout_height="78dp"
        android:background="#FFFFFF"
        android:elevation="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>