<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#061B2A"
    android:fitsSystemWindows="true"
    tools:context=".citas.MisCitasActivity">

    <!-- CONTENIDO DE LA PANTALLA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- BARRA SUPERIOR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="#082536"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="20dp">

            <TextView
                android:id="@+id/tvBackMisCitas"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="70dp"
                android:gravity="center"
                android:paddingEnd="12dp"
                android:text="‹  Volver"
                android:textColor="#08B9FF"
                android:textSize="16sp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Volver al inicio" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="BARBERAPP"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />
        </LinearLayout>

        <!-- PANEL DE PRESENTACIÓN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_panel_login"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TUS RESERVAS"
                android:textColor="#08B9FF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.10" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Mis citas"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Consulta tus reservas y revisa el estado de cada cita."
                android:textColor="#AFC6D8"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>

        <!-- HISTORIAL -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="26dp"
            android:text="Historial de citas"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="5dp"
            android:text="Aquí encontrarás tus reservas registradas."
            android:textColor="#AFC6D8"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/progresoMisCitas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:indeterminateTint="#08B9FF"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvEstadoMisCitas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="12dp"
            android:padding="12dp"
            android:gravity="center"
            android:text="Cargando tus citas..."
            android:textColor="#B8C9D5"
            android:textSize="14sp" />

        <!-- LISTA DE CITAS -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMisCitas"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="6dp"
            android:clipToPadding="false"
            android:paddingTop="10dp"
            android:paddingBottom="12dp"
            android:scrollbars="none"
            android:overScrollMode="never"
            tools:itemCount="3"
            tools:listitem="@layout/item_cita" />

    </LinearLayout>

    <!-- BARRA INFERIOR COMPARTIDA -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/bottomNavContainer"
        android:name="pe.edu.cibertec.app_barberia.navegacion.BottomNavFragment"
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:elevation="8dp" />

</LinearLayout>
