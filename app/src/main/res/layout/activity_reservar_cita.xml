<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#061B2A"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:scrollbars="none"
    tools:context=".citas.ReservarCitaActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="#082536"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="20dp">

            <TextView
                android:id="@+id/tvBackReservar"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="70dp"
                android:gravity="center"
                android:paddingEnd="12dp"
                android:text="‹  Volver"
                android:textColor="#08B9FF"
                android:textSize="16sp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Volver al inicio" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="BARBERAPP"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_panel_login"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="AGENDA TU VISITA"
                    android:textColor="#08B9FF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.10" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Reserva tu cita"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Elige tu servicio, barbero y horario para programar tu visita."
                    android:textColor="#AFC6D8"
                    android:textSize="14sp"
                    android:lineSpacingExtra="3dp" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="Detalles de tu reserva"
                android:textColor="#FFFFFF"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Completa los siguientes datos."
                android:textColor="#AFC6D8"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_panel_login"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SERVICIO"
                    android:textColor="#AFC6D8"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:labelFor="@id/spServicio" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="9dp">

                    <Spinner
                        android:id="@+id/spServicio"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/card_home"
                        android:paddingStart="14dp"
                        android:paddingEnd="38dp"
                        android:spinnerMode="dropdown"
                        android:contentDescription="Seleccionar servicio" />

                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="end"
                        android:gravity="center"
                        android:text="▾"
                        android:textColor="#17344B"
                        android:textSize="21sp"
                        android:clickable="false"
                        android:focusable="false"
                        android:importantForAccessibility="no" />

                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="23dp"
                    android:text="BARBERO"
                    android:textColor="#AFC6D8"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:labelFor="@id/spBarbero" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="9dp">

                    <Spinner
                        android:id="@+id/spBarbero"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/card_home"
                        android:paddingStart="14dp"
                        android:paddingEnd="38dp"
                        android:spinnerMode="dropdown"
                        android:contentDescription="Seleccionar barbero" />

                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="end"
                        android:gravity="center"
                        android:text="▾"
                        android:textColor="#17344B"
                        android:textSize="21sp"
                        android:clickable="false"
                        android:focusable="false"
                        android:importantForAccessibility="no" />

                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="23dp"
                    android:text="FECHA DE LA CITA"
                    android:textColor="#AFC6D8"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFecha"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="9dp"
                    android:text="Seleccionar fecha"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    app:backgroundTint="#123449"
                    app:cornerRadius="14dp"
                    app:strokeColor="#1D779C"
                    app:strokeWidth="1dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="23dp"
                    android:text="HORARIO DISPONIBLE"
                    android:textColor="#AFC6D8"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:labelFor="@id/spHora" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="9dp">

                    <Spinner
                        android:id="@+id/spHora"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/card_home"
                        android:paddingStart="14dp"
                        android:paddingEnd="38dp"
                        android:spinnerMode="dropdown"
                        android:contentDescription="Seleccionar hora" />

                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="end"
                        android:gravity="center"
                        android:text="▾"
                        android:textColor="#17344B"
                        android:textSize="21sp"
                        android:clickable="false"
                        android:focusable="false"
                        android:importantForAccessibility="no" />

                </FrameLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConfirmarCita"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="30dp"
                    android:text="Confirmar cita"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="#1599E8"
                    app:cornerRadius="18dp" />

                <ProgressBar
                    android:id="@+id/progresoReserva"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="18dp"
                    android:indeterminateTint="#08B9FF"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvEstadoReserva"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:gravity="center"
                    android:textColor="#B8C9D5"
                    android:textSize="14sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>