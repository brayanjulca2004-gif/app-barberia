<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9FC">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="74dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:paddingStart="16dp"
        android:paddingEnd="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvBackReservar"
            android:layout_width="42dp"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:text="‹"
            android:textSize="36sp"
            android:textColor="#2563A6"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Volver"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="46dp"
            android:layout_height="46dp"
            app:cardBackgroundColor="#EAF2FB"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            android:clipToOutline="true">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/logo_barberapp"
                android:scaleType="centerCrop"
                android:contentDescription="Logo BarberApp"/>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="BARBERAPP"
            android:textColor="#1D3557"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"/>
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollReservar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#F7F9FC"
        android:fillViewport="false"
        android:clipToPadding="false"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/bottomNavContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="27dp"
            android:paddingBottom="32dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#1D3557"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="23dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="AGENDA TU VISITA"
                        android:textSize="11sp"
                        android:textColor="#C9DBEF"
                        android:textStyle="bold"
                        android:letterSpacing="0.10"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Reserva tu cita"
                        android:textSize="25sp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:layout_marginTop="14dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Elige el servicio, barbero, fecha y horario de tu próxima visita."
                        android:textSize="13sp"
                        android:textColor="#D8E5F3"
                        android:layout_marginTop="10dp"
                        android:lineSpacingExtra="4dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Detalles de tu reserva"
                android:textSize="20sp"
                android:textColor="#1D3557"
                android:textStyle="bold"
                android:layout_marginTop="32dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Completa los siguientes datos."
                android:textSize="13sp"
                android:textColor="#607B9B"
                android:layout_marginTop="6dp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                android:layout_marginTop="19dp"
                app:strokeColor="#E0E9F4"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="21dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="SERVICIO"
                        android:textSize="11sp"
                        android:textColor="#2563A6"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:labelFor="@id/spServicio"/>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        app:cardBackgroundColor="#F7F9FC"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        android:layout_marginTop="10dp"
                        app:strokeColor="#DFE8F3"
                        app:strokeWidth="1dp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <Spinner
                                android:id="@+id/spServicio"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@android:color/transparent"
                                android:paddingStart="16dp"
                                android:paddingEnd="38dp"
                                android:spinnerMode="dropdown"
                                android:contentDescription="Seleccionar servicio"/>

                            <TextView
                                android:layout_width="36dp"
                                android:layout_height="match_parent"
                                android:layout_gravity="end"
                                android:gravity="center"
                                android:text="▾"
                                android:textColor="#2563A6"
                                android:textSize="22sp"
                                android:clickable="false"
                                android:focusable="false"
                                android:importantForAccessibility="no"/>
                        </FrameLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="BARBERO"
                        android:textSize="11sp"
                        android:textColor="#2563A6"
                        android:textStyle="bold"
                        android:layout_marginTop="24dp"
                        android:letterSpacing="0.05"
                        android:labelFor="@id/spBarbero"/>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        app:cardBackgroundColor="#F7F9FC"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        android:layout_marginTop="10dp"
                        app:strokeColor="#DFE8F3"
                        app:strokeWidth="1dp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <Spinner
                                android:id="@+id/spBarbero"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@android:color/transparent"
                                android:paddingStart="16dp"
                                android:paddingEnd="38dp"
                                android:spinnerMode="dropdown"
                                android:contentDescription="Seleccionar barbero"/>

                            <TextView
                                android:layout_width="36dp"
                                android:layout_height="match_parent"
                                android:layout_gravity="end"
                                android:gravity="center"
                                android:text="▾"
                                android:textColor="#2563A6"
                                android:textSize="22sp"
                                android:clickable="false"
                                android:focusable="false"
                                android:importantForAccessibility="no"/>
                        </FrameLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="FECHA DE LA CITA"
                        android:textSize="11sp"
                        android:textColor="#2563A6"
                        android:textStyle="bold"
                        android:layout_marginTop="24dp"
                        android:letterSpacing="0.05"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFecha"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="10dp"
                        android:text="Seleccionar fecha"
                        android:textAllCaps="false"
                        android:textColor="#1D3557"
                        android:textSize="14sp"
                        app:backgroundTint="#F7F9FC"
                        app:strokeColor="#DFE8F3"
                        app:strokeWidth="1dp"
                        app:cornerRadius="14dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="HORA DE LA CITA"
                        android:textSize="11sp"
                        android:textColor="#2563A6"
                        android:textStyle="bold"
                        android:layout_marginTop="24dp"
                        android:letterSpacing="0.05"
                        android:labelFor="@id/spHora"/>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        app:cardBackgroundColor="#F7F9FC"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        android:layout_marginTop="10dp"
                        app:strokeColor="#DFE8F3"
                        app:strokeWidth="1dp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <Spinner
                                android:id="@+id/spHora"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@android:color/transparent"
                                android:paddingStart="16dp"
                                android:paddingEnd="38dp"
                                android:spinnerMode="dropdown"
                                android:contentDescription="Seleccionar hora de la cita"/>

                            <TextView
                                android:layout_width="36dp"
                                android:layout_height="match_parent"
                                android:layout_gravity="end"
                                android:gravity="center"
                                android:text="▾"
                                android:textColor="#2563A6"
                                android:textSize="22sp"
                                android:clickable="false"
                                android:focusable="false"
                                android:importantForAccessibility="no"/>
                        </FrameLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Las horas se muestran según la fecha elegida. La reserva queda sujeta a confirmación del servidor."
                        android:textSize="12sp"
                        android:textColor="#607B9B"
                        android:layout_marginTop="10dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnConfirmarCita"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="26dp"
                        android:text="Confirmar cita"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:textAllCaps="false"
                        app:backgroundTint="#1D3557"
                        app:cornerRadius="15dp"/>

                    <ProgressBar
                        android:id="@+id/progresoReserva"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="18dp"
                        android:indeterminateTint="#2563A6"
                        android:visibility="gone"/>

                    <TextView
                        android:id="@+id/tvEstadoReserva"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center"
                        android:textColor="#607B9B"
                        android:textSize="13sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/bottomNavContainer"
        android:name="pe.edu.cibertec.app_barberia.navegacion.BottomNavFragment"
        android:layout_width="0dp"
        android:layout_height="78dp"
        android:background="#FFFFFF"
        android:elevation="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>