<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:contentDescription="Logo BarberApp"
            android:scaleType="centerCrop"
            android:src="@drawable/logo_barberapp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvServicioProxima"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Corte clásico"
                android:textColor="#17344B"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBarberoProxima"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Barbero: Carlos Ramírez"
                android:textColor="#587087"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvFechaProxima"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Hoy · 17:00"
                android:textColor="#176B9F"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRestanteProxima"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Faltan 30 minutos"
                android:textColor="#587087"
                android:textSize="12sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvEstadoProxima"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/card_home"
            android:paddingHorizontal="7dp"
            android:paddingVertical="5dp"
            android:text="PENDIENTE"
            android:textColor="#17344B"
            android:textSize="10sp"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
