<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9FC"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="28dp"
        android:paddingBottom="32dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="92dp"
            android:layout_height="92dp"
            app:cardBackgroundColor="#EAF2FB"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            android:clipToOutline="true">

            <ImageView
                android:id="@+id/ivLogoRegistro"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/logo_barberapp"
                android:scaleType="centerCrop"
                android:contentDescription="Logo BarberApp"/>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BARBERAPP"
            android:textSize="25sp"
            android:textColor="#1D3557"
            android:textStyle="bold"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:letterSpacing="0.08"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TU EXPERIENCIA COMIENZA AQUÍ"
            android:textSize="11sp"
            android:textColor="#2563A6"
            android:textStyle="bold"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:letterSpacing="0.10"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tu estilo merece una experiencia diferente."
            android:textSize="14sp"
            android:textColor="#607B9B"
            android:layout_marginTop="8dp"
            android:gravity="center"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            android:layout_marginTop="23dp"
            app:strokeColor="#DFE8F3"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Crea tu cuenta"
                    android:textSize="23sp"
                    android:textColor="#1D3557"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Completa tus datos para comenzar."
                    android:textSize="14sp"
                    android:textColor="#607B9B"
                    android:layout_marginTop="7dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="NOMBRE COMPLETO"
                    android:textSize="11sp"
                    android:textColor="#2563A6"
                    android:textStyle="bold"
                    android:layout_marginTop="23dp"
                    android:letterSpacing="0.05"
                    android:labelFor="@id/etNombreRegistro"/>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#F7F9FC"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    android:layout_marginTop="10dp"
                    app:strokeColor="#DFE8F3"
                    app:strokeWidth="1dp">

                    <EditText
                        android:id="@+id/etNombreRegistro"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@android:color/transparent"
                        android:hint="Ingresa tu nombre completo"
                        android:inputType="textPersonName|textCapWords"
                        android:singleLine="true"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textColor="#1D3557"
                        android:textColorHint="#91A3B8"
                        android:textSize="14sp"/>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="NÚMERO DE TELÉFONO"
                    android:textSize="11sp"
                    android:textColor="#2563A6"
                    android:textStyle="bold"
                    android:layout_marginTop="17dp"
                    android:letterSpacing="0.05"
                    android:labelFor="@id/etTelefonoRegistro"/>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#F7F9FC"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    android:layout_marginTop="10dp"
                    app:strokeColor="#DFE8F3"
                    app:strokeWidth="1dp">

                    <EditText
                        android:id="@+id/etTelefonoRegistro"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@android:color/transparent"
                        android:hint="Ingresa tu teléfono"
                        android:inputType="phone"
                        android:singleLine="true"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textColor="#1D3557"
                        android:textColorHint="#91A3B8"
                        android:textSize="14sp"
                        android:maxLength="9"/>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CORREO ELECTRÓNICO"
                    android:textSize="11sp"
                    android:textColor="#2563A6"
                    android:textStyle="bold"
                    android:layout_marginTop="17dp"
                    android:letterSpacing="0.05"
                    android:labelFor="@id/etCorreoRegistro"/>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#F7F9FC"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    android:layout_marginTop="10dp"
                    app:strokeColor="#DFE8F3"
                    app:strokeWidth="1dp">

                    <EditText
                        android:id="@+id/etCorreoRegistro"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@android:color/transparent"
                        android:hint="Ingresa tu correo electrónico"
                        android:inputType="textEmailAddress"
                        android:singleLine="true"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textColor="#1D3557"
                        android:textColorHint="#91A3B8"
                        android:textSize="14sp"/>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CONTRASEÑA"
                    android:textSize="11sp"
                    android:textColor="#2563A6"
                    android:textStyle="bold"
                    android:layout_marginTop="17dp"
                    android:letterSpacing="0.05"
                    android:labelFor="@id/etPasswordRegistro"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:boxBackgroundMode="outline"
                    app:boxBackgroundColor="#F7F9FC"
                    app:boxStrokeColor="#DFE8F3"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:endIconMode="password_toggle"
                    app:endIconTint="#2563A6"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPasswordRegistro"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@android:color/transparent"
                        android:hint="Crea una contraseña"
                        android:inputType="textPassword"
                        android:singleLine="true"
                        android:paddingStart="16dp"
                        android:textColor="#1D3557"
                        android:textColorHint="#91A3B8"
                        android:textSize="14sp"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRegistrar"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="26dp"
                    android:text="Crear cuenta"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:textAllCaps="false"
                    app:backgroundTint="#1D3557"
                    app:cornerRadius="15dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="21dp"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:id="@+id/tvTieneCuenta"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:text="¿Ya tienes una cuenta?"
                android:textColor="#607B9B"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/tvVolverLogin"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:paddingStart="9dp"
                android:gravity="center_vertical"
                android:text="Inicia sesión"
                android:textColor="#2563A6"
                android:textSize="13sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BARBERAPP"
            android:textSize="10sp"
            android:textColor="#607B9B"
            android:textStyle="bold"
            android:layout_marginTop="19dp"
            android:gravity="center"
            android:letterSpacing="0.10"/>
    </LinearLayout>
</ScrollView>