<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#061B2A"
    tools:context=".home.HomeActivity">

    <!-- BARRA SUPERIOR -->
    <View
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:background="#082536"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:text="BARBERAPP"
        android:textColor="#FFFFFF"
        android:textSize="19sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        app:layout_constraintStart_toStartOf="@id/topBar"
        app:layout_constraintTop_toTopOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="@id/topBar" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:text="INICIO"
        android:textColor="#08B9FF"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/topBar"
        app:layout_constraintTop_toTopOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="@id/topBar" />

    <TextView
        android:id="@+id/tvBack"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- CONTENIDO DESPLAZABLE -->
    <ScrollView
        android:id="@+id/scrollHome"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/bottomNavContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="22dp"
            android:paddingBottom="28dp">

            <!-- PANEL PERSONAL -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_panel_login"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TU ESPACIO PERSONAL"
                        android:textColor="#08B9FF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.10" />

                    <TextView
                        android:id="@+id/tvSaludo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Hola, Usuario"
                        android:textColor="#FFFFFF"
                        android:textSize="23sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPregunta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="¿Qué deseas hacer hoy?"
                        android:textColor="#AFC6D8"
                        android:textSize="14sp" />
                </LinearLayout>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardHomeAvatar"
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:layout_marginStart="14dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="42dp"
                    app:cardBackgroundColor="#08B9FF"
                    app:cardElevation="6dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="78dp"
                        android:layout_height="78dp"
                        android:layout_gravity="center"
                        app:cardCornerRadius="39dp"
                        app:cardBackgroundColor="#061B2A">

                        <ImageView
                            android:id="@+id/ivHomeFotoPerfil"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@android:drawable/ic_menu_myplaces"
                            android:contentDescription="Foto de perfil" />
                    </androidx.cardview.widget.CardView>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- EXPLORAR BARBERAPP -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Explora BarberApp"
                android:textColor="#FFFFFF"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Todo lo que necesitas, en un solo lugar."
                android:textColor="#AFC6D8"
                android:textSize="13sp" />

            <!-- TARJETAS: SERVICIOS Y BARBEROS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="19dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/cardServicios"
                    android:layout_width="0dp"
                    android:layout_height="145dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="7dp"
                    android:background="@drawable/card_home"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Ver servicios">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✂"
                        android:textColor="#1599E8"
                        android:textSize="39sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="Servicios"
                        android:textColor="#17344B"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Conoce las opciones"
                        android:textColor="#557589"
                        android:textSize="11sp"
                        android:gravity="center" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardBarberos"
                    android:layout_width="0dp"
                    android:layout_height="145dp"
                    android:layout_weight="1"
                    android:layout_marginStart="7dp"
                    android:background="@drawable/card_home"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Ver barberos">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💈"
                        android:textSize="37sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="Barberos"
                        android:textColor="#17344B"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Nuestro equipo"
                        android:textColor="#557589"
                        android:textSize="11sp"
                        android:gravity="center" />
                </LinearLayout>
            </LinearLayout>

            <!-- TARJETAS: RESERVAR Y MIS CITAS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/cardReservar"
                    android:layout_width="0dp"
                    android:layout_height="145dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="7dp"
                    android:background="@drawable/card_home"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Reservar cita">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📅"
                        android:textSize="36sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="Reservar cita"
                        android:textColor="#17344B"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Agenda tu visita"
                        android:textColor="#557589"
                        android:textSize="11sp"
                        android:gravity="center" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardMisCitas"
                    android:layout_width="0dp"
                    android:layout_height="145dp"
                    android:layout_weight="1"
                    android:layout_marginStart="7dp"
                    android:background="@drawable/card_home"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Consultar mis citas">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:text="⏳"
                        android:textSize="37sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="Mis citas"
                        android:textColor="#17344B"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Consulta tus reservas"
                        android:textColor="#557589"
                        android:textSize="11sp"
                        android:gravity="center" />
                </LinearLayout>
            </LinearLayout>

            <!-- PRÓXIMAS CITAS -->
            <TextView
                android:id="@+id/tvProximaCita"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="29dp"
                android:text="Próximas citas"
                android:textColor="#FFFFFF"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Tus próximas reservas programadas"
                android:textColor="#AFC6D8"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvEstadoProximasCitas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_panel_login"
                android:padding="16dp"
                android:text="Consultando tus citas..."
                android:textColor="#B7C9D8"
                android:textSize="14sp"
                android:gravity="center"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvProximasCitas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                tools:itemCount="2"
                tools:listitem="@layout/item_proxima_cita" />

        </LinearLayout>
    </ScrollView>

    <!-- BARRA INFERIOR REUTILIZABLE -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/bottomNavContainer"
        android:name="pe.edu.cibertec.app_barberia.navegacion.BottomNavFragment"
        android:layout_width="0dp"
        android:layout_height="78dp"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
